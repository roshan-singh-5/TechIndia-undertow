# Optional server-side AI configuration. Never expose these values to Vite.
# The MVP adapter currently supports OpenAI-compatible Chat Completions APIs.
AI_PROVIDER=openai
AI_API_KEY=replace-with-server-side-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional UNDERTOW settings
# UNDERTOW_DATABASE_PATH=./backend/undertow.db
# UNDERTOW_FRONTEND_ORIGINS=http://localhost:5173
