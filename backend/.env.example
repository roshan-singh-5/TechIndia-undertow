# Development defaults. Do not commit a real .env file.
UNDERTOW_DATABASE_PATH=undertow.db
UNDERTOW_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only behind HTTPS in production.
UNDERTOW_COOKIE_SECURE=false
UNDERTOW_SESSION_HOURS=8
# Optional model-assisted responses. Leave unset to use the deterministic, evidence-bounded fallback.
# UNDERTOW_AI_PROVIDER=openai
# OPENAI_API_KEY=replace_with_server_side_secret
# UNDERTOW_AI_MODEL=gpt-4.1-mini
